#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    prepend references = @/home/vincent/Desktop/mh5_physical_workcell/mh5_physical_workcell.usda@
)
{
    custom string mh5:commandAuthority = "simulation_only"
    custom bool mh5:contactValidationRequired = 1
    custom double[] mh5:homePositionRad = [0, 0, 0, 0, 0, 0.105]
    custom string mh5:mode = "sim_train_workcell"
    custom bool mh5:realInterfacesEnabled = 0
    custom double[] mh5:targetCubeCenterXYZ = [0.6, 0.25, 0.06]
    custom double mh5:targetCubeCenterZ = 0.06

    over "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def "PhysicsMaterials"
    {
        def Material "TrainingContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0.05
            float physics:staticFriction = 0.6
        }
    }

    over "PhysicalWorkcell"
    {
        over "Ground" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/PhysicsMaterials/TrainingContact>
        }

        over "Worktable"
        {
            over "Tabletop" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/PhysicsMaterials/TrainingContact>
            }
        }

        over "CameraFrame"
        {
            over "VerticalPost" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/PhysicsMaterials/TrainingContact>
            }

            over "HorizontalBeam" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </World/PhysicsMaterials/TrainingContact>
            }
        }

        over "OpposingRobotKeepout" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </World/PhysicsMaterials/TrainingContact>
        }
    }

    def "TrainingObjects"
    {
        def Cube "TargetCube" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            rel material:binding:physics = </World/PhysicsMaterials/TrainingContact>
            bool physics:collisionEnabled = 1
            float physics:mass = 0.25
            bool physics:rigidBodyEnabled = 1
            color3f[] primvars:displayColor = [(0.8, 0.12, 0.08)]
            double size = 1
            double3 xformOp:scale = (0.08, 0.08, 0.12)
            double3 xformOp:translate = (0.6, 0.25, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    over "mh5_rg2ft"
    {
        over "joints"
        {
            over "joint_1_s"
            {
                float drive:angular:physics:damping = 80
                float drive:angular:physics:stiffness = 400
            }

            over "joint_2_l"
            {
                float drive:angular:physics:damping = 80
                float drive:angular:physics:stiffness = 400
            }

            over "joint_3_u"
            {
                float drive:angular:physics:damping = 80
                float drive:angular:physics:stiffness = 400
            }

            over "joint_4_r"
            {
                float drive:angular:physics:damping = 80
                float drive:angular:physics:stiffness = 400
            }

            over "joint_5_b"
            {
                float drive:angular:physics:damping = 80
                float drive:angular:physics:stiffness = 400
            }

            over "joint_6_t"
            {
                float drive:angular:physics:damping = 80
                float drive:angular:physics:stiffness = 400
            }

            over "finger_joint"
            {
                float drive:angular:physics:damping = 30
                float drive:angular:physics:stiffness = 200
            }
        }
    }
}

